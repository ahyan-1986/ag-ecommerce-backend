# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ag_ecommerce_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-this-secret-in-production-at-least-32-chars
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# SMTP Email (leave SMTP_HOST blank to disable email sending)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@asianmum.my
SMTP_FROM_NAME=AsianMum
APP_URL=http://localhost:5173

# S3 / MinIO Object Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=asianmum
S3_PREFIX=
S3_USE_SSL=true
S3_PUBLIC_URL=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Stripe Payment (Malaysia FPX + Cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=myr

# WhatsApp Business API (Meta)
# Configure via admin dashboard — stored in DB
